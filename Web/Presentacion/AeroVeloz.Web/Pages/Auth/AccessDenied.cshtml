@page
@model AeroVeloz.Web.Pages.Auth.AccessDeniedModel
@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container text-center mt-5">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <h1 class="text-danger display-1"><i class="bi bi-shield-lock"></i></h1>
            <h2 class="text-danger mt-3">Acceso Denegado</h2>
            <p class="lead text-muted mt-3">
                No tienes los permisos necesarios para ver esta página o realizar esta acción.
            </p>
            <p>
                Si crees que esto es un error, por favor contacta al administrador del sistema para que revise los roles asignados a tu cuenta.
            </p>
            <a href="/Index" class="btn btn-primary mt-4">Volver al Inicio</a>
        </div>
    </div>
</div>
