@model AeroVeloz.Web.Models.Flights.FlightReadDto

<tr class="hover-actions align-middle">
    <td>
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3 text-primary d-none d-md-block">
                <i class="bi bi-airplane-fill"></i>
            </div>
            <div>
                <div class="fw-bold text-dark">#@Model.FlightNumber</div>
                <div class="text-muted small">@Model.CodeAirlinesIcao</div>
            </div>
        </div>
    </td>
    <td><span class="fw-medium">@Model.CodeAirlinesIcao</span></td>
    <td>@Model.OriginAirport</td>
    <td>@Model.DestinationAirport</td>
    <td>
        <div class="text-dark small">@Model.ScheduledDeparture.ToString("dd MMM yyyy, HH:mm")</div>
    </td>
    <td>
        @{
            var (badgeClass, dotClass) = Model.FlightStateId switch {
                1 => ("bg-secondary bg-opacity-10 text-secondary", "bg-secondary"),
                2 => ("bg-warning bg-opacity-10 text-warning", "bg-warning"),
                3 => ("bg-danger bg-opacity-10 text-danger", "bg-danger"),
                4 => ("bg-info bg-opacity-10 text-info", "bg-info"),
                5 => ("bg-success bg-opacity-10 text-success", "bg-success"),
                6 => ("bg-primary bg-opacity-10 text-primary", "bg-primary"),
                7 => ("bg-dark bg-opacity-10 text-dark", "bg-dark"),
                8 => ("bg-danger bg-opacity-10 text-danger", "bg-danger"),
                _ => ("bg-light text-dark", "bg-dark")
            };

            var stateNameEs = Model.FlightStateId switch {
                1 => "Programado",
                2 => "Abordaje",
                3 => "Retrasado",
                4 => "En Vuelo",
                5 => "Aterrizado",
                6 => "Completado",
                7 => "Cancelado",
                8 => "Desviado",
                _ => Model.FlightStateName
            };
        }
        <span class="badge @badgeClass d-inline-flex align-items-center py-2 px-3 shadow-sm border" style="border-color: currentColor !important;">
            <span class="rounded-circle me-2 @dotClass shadow-sm" style="width: 8px; height: 8px;"></span>
            @stateNameEs.ToUpper()
        </span>
    </td>
    <td class="text-end pe-4">
        <a class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-sm" asp-page="/Flights/Details" asp-route-flightNumber="@Model.FlightNumber" asp-route-airline="@Model.CodeAirlinesIcao" data-bs-toggle="tooltip" title="Ver Detalles del Vuelo">
            <i class="bi bi-eye-fill"></i> Detalles
        </a>
    </td>
</tr>
