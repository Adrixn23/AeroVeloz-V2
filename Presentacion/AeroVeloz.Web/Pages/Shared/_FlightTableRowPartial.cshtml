@model AeroVeloz.Web.Models.Flights.FlightReadDto

<tr>
    <td>
        <div class="d-flex align-items-center">
            <div class="bg-primary bg-opacity-10 p-2 rounded-3 me-3 text-primary d-none d-md-block">
                <i class="bi bi-airplane-fill"></i>
            </div>
            <div>
                <div class="fw-bold text-dark">#@Model.FlightNumber</div>
                <div class="text-muted small">@Model.CodeAirlinesIcao</div>
            </div>
        </div>
    </td>
    <td><span class="fw-medium">@Model.CodeAirlinesIcao</span></td>
    <td>@Model.OriginAirport</td>
    <td>@Model.DestinationAirport</td>
    <td>@Model.ScheduledDeparture.ToString("dd/MM/yyyy HH:mm")</td>
    <td>
        @{
            var badgeClass = Model.FlightStateId switch {
                1 => "bg-secondary", // Scheduled
                2 => "bg-warning text-dark",   // Boarding
                3 => "bg-danger",     // Delayed
                4 => "bg-info text-dark",           // In Flight
                5 => "bg-success",   // Landed
                6 => "bg-primary",   // Completed
                _ => "bg-light text-dark"
            };
        }
        <span class="badge @badgeClass">
            @Model.FlightStateName
        </span>
    </td>
    <td>
        <a class="btn btn-sm btn-outline-primary" asp-page="/Flights/Details" asp-route-flightNumber="@Model.FlightNumber" asp-route-airline="@Model.CodeAirlinesIcao">
            <i class="bi bi-eye"></i> Ver Detalle
        </a>
    </td>
</tr>
