<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand text-white" asp-area="" asp-page="/Index">AeroVeloz Admin</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("AIRLINEADMIN") || User.IsInRole("SYSTEMADMIN"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/SuperAdmin/Index">Dashboard Aerolínea</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/SuperAdmin/BatchUpload">Carga Masiva</a>
                            </li>
                        }

                        @if (User.IsInRole("AIRPORTADMIN") || User.IsInRole("SYSTEMADMIN"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/AirportAdmin/Index">Monitor Vuelos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/AirportAdmin/Staff">Personal</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/AirportAdmin/Airlines">Aerolíneas Locales</a>
                            </li>
                        }

                        @if (User.IsInRole("OPERATIONAIRPORT") || User.IsInRole("SYSTEMADMIN") || User.IsInRole("AIRLINEADMIN"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/Operator/Index">Mostrador (Boarding)</a>
                            </li>
                        }
                        
                        @if (User.IsInRole("SYSTEMADMIN"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-page="/SuperAdmin/Audit">Auditoría Global</a>
                            </li>
                        }
                    }
                </ul>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="navbar-text text-white me-3">
                        <small>@User.Identity.Name (@User.Claims.FirstOrDefault(c => c.Type == "OrganizationName")?.Value)</small>
                    </span>
                    <a class="btn btn-outline-light btn-sm" asp-area="" asp-page="/Auth/Logout">Salir</a>
                }
            </div>
        </div>
    </nav>
</header>
