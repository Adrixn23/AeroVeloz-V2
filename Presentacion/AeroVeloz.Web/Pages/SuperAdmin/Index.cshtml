@page
@model AeroVeloz.Web.Pages.SuperAdmin.IndexModel
@{
    ViewData["Title"] = "Dashboard Aerolínea";
}

<div class="row mb-5 align-items-end">
    <div class="col-md-8">
        <h6 class="text-primary fw-bold text-uppercase mb-1" style="letter-spacing: 0.1em;">Panel de Control</h6>
        <h1 class="display-5 fw-bold">Hola, @Model.UserName</h1>
        <p class="text-muted fs-5">Gestionando la flota de <span class="text-dark fw-semibold">@Model.Organization</span></p>
    </div>
    <div class="col-md-4 text-end pb-2">
        <div class="bg-white shadow-sm rounded-4 p-3 d-inline-block border">
            <div class="text-muted small text-uppercase fw-bold mb-1" style="font-size: 0.6rem;">Estado del Sistema</div>
            <div class="d-flex align-items-center text-success fw-bold">
                <span class="spinner-grow spinner-grow-sm me-2" role="status"></span>
                Sincronizado
            </div>
        </div>
    </div>
</div>

<div class="card shadow-lg border-0 overflow-hidden mb-5">
    <div class="card-header bg-white border-0 py-4 px-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h4 class="fw-bold mb-0">Itinerarios Activos</h4>
            <span class="text-muted small">Actualizado en tiempo real desde la API</span>
        </div>
        <div class="d-flex align-items-center gap-3">
            <a asp-page="/SuperAdmin/BatchUpload" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Nueva Carga Masiva
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-warning m-4 rounded-4 border-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
            </div>
        }

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 datatable" id="flightsTable">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Vuelo / Aerolínea</th>
                        <th>Ruta</th>
                        <th>Salida</th>
                        <th>Estado</th>
                        <th class="pe-4 text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    @if (Model.Flights != null && Model.Flights.Any())
                    {
                        @foreach (var flight in Model.Flights)
                        {
                            <partial name="_FlightTableRowPartial" model="flight" />
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
