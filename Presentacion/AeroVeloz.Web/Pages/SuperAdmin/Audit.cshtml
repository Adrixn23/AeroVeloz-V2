@page
@model AeroVeloz.Web.Pages.SuperAdmin.AuditModel
@{
    ViewData["Title"] = "Auditoría Global";
}

<div class="row mb-4">
    <div class="col-md-12">
        <h2>Registro de Auditoría Global</h2>
        <p class="text-muted">Historial detallado de todas las acciones realizadas en el sistema (Súper Administrador).</p>
        
        @if (Model.FilteredUserId.HasValue)
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center">
                <span>Filtrando por ID de Usuario: <strong>@Model.FilteredUserId</strong></span>
                <a asp-page="/SuperAdmin/Audit" class="btn btn-sm btn-link">Limpiar Filtro</a>
            </div>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">
        @Model.ErrorMessage
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (Model.Audits != null && Model.Audits.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Fecha</th>
                            <th>Acción</th>
                            <th>Usuario</th>
                            <th>Entidad</th>
                            <th>Detalle de Datos</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var audit in Model.Audits)
                        {
                            <tr>
                                <td><small>@audit.OccurredAt.ToString("g")</small></td>
                                <td><span class="badge bg-info">@audit.AuditTypeName</span></td>
                                <td>
                                    <a asp-page="/SuperAdmin/Audit" asp-route-userIdFilter="@audit.IdUser">@audit.NameUser</a>
                                    <br/><small class="text-muted">@audit.NameOrganization</small>
                                </td>
                                <td>@audit.NameEntity</td>
                                <td>
                                    <button class="btn btn-sm btn-link" type="button" data-bs-toggle="collapse" data-bs-target="#audit-@audit.AuditId.ToString().Substring(0,8)">
                                        Ver JSON
                                    </button>
                                    <div class="collapse" id="audit-@audit.AuditId.ToString().Substring(0,8)">
                                        <pre class="bg-light p-2 mt-2" style="font-size: 0.75rem; max-width: 300px; overflow-x: auto;">@audit.DataNew</pre>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center text-muted">
                <p>No hay registros de auditoría disponibles.</p>
            </div>
        }
    </div>
</div>
