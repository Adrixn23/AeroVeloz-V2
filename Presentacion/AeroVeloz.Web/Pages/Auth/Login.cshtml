@page
@model AeroVeloz.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Acceso - AeroVeloz";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .brand-logo {
            font-size: 2rem;
            font-weight: 800;
            color: #3b82f6;
            text-align: center;
            margin-bottom: 8px;
            letter-spacing: -0.02em;
        }

        .sub-title {
            color: #94a3b8;
            text-align: center;
            margin-bottom: 32px;
            font-size: 0.9rem;
        }

        .form-label {
            color: #e2e8f0;
            font-weight: 500;
            font-size: 0.85rem;
            margin-bottom: 8px;
        }

        .form-control {
            background: #ffffff !important;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            color: #0f172a !important;
            padding: 12px 16px;
            transition: all 0.2s ease;
        }

        .form-control:focus {
            background: #ffffff !important;
            border-color: #3b82f6;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.2);
            color: #0f172a !important;
        }

        /* Asegurar que el autocompletado del navegador no cambie el color */
        .form-control:-webkit-autofill,
        .form-control:-webkit-autofill:hover, 
        .form-control:-webkit-autofill:focus {
            -webkit-text-fill-color: #0f172a !important;
            -webkit-box-shadow: 0 0 0px 1000px white inset !important;
            transition: background-color 5000s ease-in-out 0s;
        }

        .btn-login {
            background: #3b82f6;
            border: none;
            border-radius: 12px;
            padding: 14px;
            font-weight: 600;
            font-size: 1rem;
            margin-top: 16px;
            transition: all 0.3s ease;
        }

        .btn-login:hover {
            background: #2563eb;
            transform: translateY(-1px);
            box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.3);
        }

        .alert-custom {
            background: rgba(239, 68, 68, 0.1);
            border: 1px solid rgba(239, 68, 68, 0.2);
            color: #fca5a5;
            border-radius: 12px;
            font-size: 0.85rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="brand-logo"><i class="bi bi-airplane-engines"></i> AeroVeloz</div>
        <div class="sub-title">Gestión Inteligente de Información de Vuelos</div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-custom mb-4" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i> @Model.ErrorMessage
            </div>
        }

        <form method="post" id="loginForm">
            <div class="mb-3">
                <label asp-for="Input.EmailOrganization" class="form-label">Email Corporativo</label>
                <input asp-for="Input.EmailOrganization" class="form-control" placeholder="nombre@aeroveloz.com" />
                <span asp-validation-for="Input.EmailOrganization" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.NameUser" class="form-label">Username</label>
                <input asp-for="Input.NameUser" class="form-control" placeholder="AdminTest" />
                <span asp-validation-for="Input.NameUser" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-login w-100" id="btnSubmit">
                <span id="spinner" class="spinner-border spinner-border-sm d-none me-2" role="status" aria-hidden="true"></span>
                Acceder al Sistema
            </button>
        </form>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        $('#loginForm').on('submit', function (e) {
            if ($(this).valid()) {
                $('#spinner').removeClass('d-none');
                $('#btnSubmit').text('Verificando...').prop('disabled', true);
            }
        });
    </script>
</body>
</html>
