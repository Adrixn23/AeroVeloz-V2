@page
@model AeroVeloz.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; // No usamos el layout general aquí
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AeroVeloz</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .login-container { max-width: 400px; margin: 100px auto; padding: 20px; background: white; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
    </style>
</head>
<body>
    <div class="container">
        <div class="login-container">
            <h2 class="text-center mb-4">AeroVeloz Admin</h2>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger" role="alert">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" id="loginForm">
                <div class="mb-3">
                    <label asp-for="Input.EmailOrganization" class="form-label">Correo de Organización</label>
                    <input asp-for="Input.EmailOrganization" class="form-control" placeholder="admin@aeropuerto.com" />
                    <span asp-validation-for="Input.EmailOrganization" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.NameUser" class="form-label">Usuario</label>
                    <input asp-for="Input.NameUser" class="form-control" placeholder="AdminTest" />
                    <span asp-validation-for="Input.NameUser" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label">Contraseña</label>
                    <input asp-for="Input.Password" type="password" class="form-control" />
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100" id="btnSubmit">
                    <span id="spinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    Iniciar Sesión
                </button>
            </form>
        </div>
    </div>

    <!-- Scripts de validación del cliente (Validaciones Distribuidas) -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    
    <script>
        // UX Heurística: Spinner de carga
        $('#loginForm').on('submit', function (e) {
            if ($(this).valid()) {
                $('#spinner').removeClass('d-none');
                $('#btnSubmit').prop('disabled', true);
            }
        });
    </script>
</body>
</html>
