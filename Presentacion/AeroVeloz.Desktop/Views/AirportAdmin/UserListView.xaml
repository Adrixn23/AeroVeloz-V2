<UserControl x:Class="AeroVeloz.Desktop.Views.AirportAdmin.UserListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Gestión de Operadores" FontSize="26" FontWeight="SemiBold" Foreground="#333333"/>
            <TextBlock Text="Administra los operadores de tu aeropuerto." FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBox Width="300" Padding="12,8" materialDesign:HintAssist.Hint="Buscar operador..." 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Nuevo Operador" 
                    Command="{Binding CreateUserCommand}" Margin="16,0,0,0" Padding="16,8"/>
            <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Refrescar" 
                    Command="{Binding LoadUsersCommand}" Margin="8,0,0,0" Padding="16,8"
                    Foreground="{DynamicResource PrimaryHueMidBrush}" Loaded="RefreshButton_Loaded"/>
        </StackPanel>

        <!-- Users DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Background="White" IsReadOnly="True"
                  materialDesign:DataGridAssist.CellPadding="4" materialDesign:DataGridAssist.ColumnHeaderPadding="4">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding ViewDetailsCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            </DataGrid.InputBindings>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Ver Detalles" Command="{Binding ViewDetailsCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Eye" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Editar Operador" Command="{Binding EditUserCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Pencil" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="InformaciÃ³n de AuditorÃ­a" Command="{Binding ViewUserAuditCommand}">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="History" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Desactivar Operador" Command="{Binding DeleteUserCommand}" Foreground="#D32F2F">
                        <MenuItem.Icon>
                            <materialDesign:PackIcon Kind="Delete" Foreground="#D32F2F" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="150"/>
                <DataGridTextColumn Header="Nombre de Usuario" Binding="{Binding FullName}" Width="200"/>
                <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive, Mode=OneWay}" Width="80"/>
                <DataGridTemplateColumn Header="Acciones" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button ToolTip="Detalles" Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="8" Height="32" Width="32" Foreground="{DynamicResource PrimaryHueMidBrush}">
                                    <materialDesign:PackIcon Kind="Eye" />
                                </Button>
                                <Button ToolTip="Editar" Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="8" Height="32" Width="32">
                                    <materialDesign:PackIcon Kind="Pencil" />
                                </Button>
                                <Button ToolTip="AuditorÃ­a" Command="{Binding DataContext.ViewUserAuditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="8" Height="32" Width="32" Foreground="{DynamicResource PrimaryHueMidBrush}">
                                    <materialDesign:PackIcon Kind="History" />
                                </Button>
                                <Button ToolTip="Desactivar" Command="{Binding DataContext.DeleteUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="8" Height="32" Width="32" Foreground="#D32F2F">
                                    <materialDesign:PackIcon Kind="UserRemove" />
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="2" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     Value="0" IsIndeterminate="True" 
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" Height="50" Width="50"/>
    </Grid>
</UserControl>


