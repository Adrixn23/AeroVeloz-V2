<UserControl x:Class="AeroVeloz.Desktop.Views.AirportAdmin.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="850" MaxHeight="650" Background="Transparent">

    <Grid Margin="16" Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="16,16,16,16">
            <TextBlock Text="Registro de Auditoría" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Consulta el historial de actividades en el sistema." FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="16,0,16,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Width="200" Padding="12,8" materialDesign:HintAssist.Hint="Buscar en auditoría..." 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBox Width="150" Padding="12,8" Margin="8,0,0,0" materialDesign:HintAssist.Hint="Filtrar usuario..." 
                         Text="{Binding FilterUser, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding TargetUserId, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Visible}"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Refrescar" 
                        Command="{Binding LoadAuditLogsCommand}" Margin="8,0,0,0" Padding="16,8"
                        Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Exportar" 
                        Command="{Binding ExportLogsCommand}" Margin="8,0,0,0" Padding="16,8"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Desde:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker SelectedDate="{Binding FilterStartDate}" Width="120" materialDesign:HintAssist.Hint="Fecha Inicio"/>
                <TextBlock Text="Hasta:" VerticalAlignment="Center" Margin="16,0,8,0"/>
                <DatePicker SelectedDate="{Binding FilterEndDate}" Width="120" materialDesign:HintAssist.Hint="Fecha Fin"/>
                <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Aplicar Filtro" 
                        Command="{Binding ApplyFiltersCommand}" Margin="16,0,0,0" Padding="16,8"
                        Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            </StackPanel>
        </StackPanel>

        <!-- Audit DataGrid Scrollable -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="16,0,16,16">
            <DataGrid ItemsSource="{Binding AuditLogs}" SelectedItem="{Binding SelectedAudit}"
                      AutoGenerateColumns="False" CanUserAddRows="False" Background="White" IsReadOnly="True"
                      materialDesign:DataGridAssist.CellPadding="4" materialDesign:DataGridAssist.ColumnHeaderPadding="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding OccurredAt, StringFormat=\{0:dd/MM/yyyy HH:mm\}}" Width="130"/>
                    <DataGridTextColumn Header="Actión" Binding="{Binding AuditTypeName}" Width="150"/>
                    <DataGridTextColumn Header="Detalle Entidad" Binding="{Binding NameEntity}" Width="180"/>
                    <DataGridTextColumn Header="Usuario" Binding="{Binding NameUser}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>

        <!-- Cerrar -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,0,16,16">
            <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="Cerrar" 
                    Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Padding="24,8"/>
        </StackPanel>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="2" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     Value="0" IsIndeterminate="True" 
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" Height="50" Width="50"/>
    </Grid>
</UserControl>

