<UserControl x:Class="AeroVeloz.Desktop.Views.AirportAdmin.OperationDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="500">

    <StackPanel Margin="16">
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,16"/>

            <!-- Operation Form -->
        <StackPanel>
            <TextBlock Text="Tipo de Cambio Operacional" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding OperationalTypes}" 
                      DisplayMemberPath="Name" 
                      SelectedValuePath="Id"
                      SelectedValue="{Binding IdOperationalType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      materialDesign:HintAssist.Hint="Seleccione un tipo de cambio"
                      Padding="12,8" Height="40" Margin="0,0,0,16"/>

            <TextBlock Text="Número de Vuelo" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox Text="{Binding FlightNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     materialDesign:HintAssist.Hint="Ej: 123"
                     MaxLength="5"
                     Padding="12,8" Height="40" Margin="0,0,0,16"/>

            <TextBlock Text="Código ICAO Aerolínea" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox Text="{Binding CodeAirline, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     materialDesign:HintAssist.Hint="Ej: AA, UA"
                     MaxLength="3"
                     Padding="12,8" Height="40" Margin="0,0,0,16"/>

            <TextBlock Text="Código ICAO Aeropuerto" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox Text="{Binding CodeAirport, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     IsEnabled="{Binding IsAirportIcaoEditable}"
                     materialDesign:HintAssist.Hint="Ej: JFK, LAX"
                     MaxLength="4"
                     Padding="12,8" Height="40" Margin="0,0,0,16"/>

            <TextBlock Text="Valor Anterior" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox Text="{Binding PreviousValue, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     materialDesign:HintAssist.Hint="Valor anterior"
                     MaxLength="25"
                     Padding="12,8" Height="40" Margin="0,0,0,16"/>

            <TextBlock Text="Nuevo Valor" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <TextBox Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"
                     materialDesign:HintAssist.Hint="Nuevo valor"
                     MaxLength="25"
                     Padding="12,8" Height="40" Margin="0,0,0,16"/>

            <TextBlock Text="Causa/Razón" FontSize="12" Foreground="Gray" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding CausesList}" 
                      SelectedItem="{Binding Cause, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      materialDesign:HintAssist.Hint="Seleccione la causa del cambio"
                      Padding="12,8" Height="40" Margin="0,0,0,16"/>

            <TextBox Text="{Binding CustomCause, UpdateSourceTrigger=PropertyChanged}"
                     Visibility="{Binding IsCustomCause, Converter={StaticResource BooleanToVisibilityConverter}}"
                     materialDesign:HintAssist.Hint="Especifique otra causa"
                     MaxLength="250"
                     AcceptsReturn="True"
                     Height="60" Margin="0,0,0,16"/>

            <!-- Loading -->
            <ProgressBar IsIndeterminate="True" 
                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                         Height="4" Margin="0,8,0,8"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}" 
                    Content="Cancelar"
                    Command="{Binding CancelCommand}"
                    Padding="16,8" Margin="0,0,8,0"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}" 
                    Content="Guardar"
                    Command="{Binding SaveCommand}"
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    Foreground="White"
                    Padding="16,8"/>
        </StackPanel>
    </StackPanel>
</UserControl>

