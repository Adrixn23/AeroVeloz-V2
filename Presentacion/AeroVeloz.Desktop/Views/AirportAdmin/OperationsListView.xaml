<UserControl x:Class="AeroVeloz.Desktop.Views.AirportAdmin.OperationsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Operaciones del Aeropuerto" FontSize="26" FontWeight="SemiBold" Foreground="#333333"/>
            <TextBlock Text="Gestiona los vuelos y operaciones." FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBox Width="300" Padding="12,8" materialDesign:HintAssist.Hint="Buscar operación..." 
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Nueva Operación" 
                    Command="{Binding CreateOperationCommand}" Margin="16,0,0,0" Padding="16,8"/>
            <Button Style="{StaticResource MaterialDesignFlatButton}" Content="Refrescar" 
                    Command="{Binding LoadOperationsCommand}" Margin="8,0,0,0" Padding="16,8"
                    Foreground="{DynamicResource PrimaryHueMidBrush}" Loaded="RefreshButton_Loaded"/>
        </StackPanel>

        <!-- Operations DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}"
                  AutoGenerateColumns="False" CanUserAddRows="False" Background="White"
                  materialDesign:DataGridAssist.CellPadding="4" materialDesign:DataGridAssist.ColumnHeaderPadding="4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120"/>
                <DataGridTextColumn Header="Tipo de Cambio" Binding="{Binding IdOperationalType}" Width="100"/>
                <DataGridTextColumn Header="Vuelo" Binding="{Binding FlightNumber}" Width="80"/>
                <DataGridTextColumn Header="Aerolínea" Binding="{Binding CodeAirline}" Width="100"/>
                <DataGridTextColumn Header="Aeropuerto" Binding="{Binding CodeAirport}" Width="100"/>
                <DataGridTextColumn Header="Causa" Binding="{Binding Cause}" Width="150"/>
                <DataGridTemplateColumn Header="Acciones" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Editar" Command="{Binding DataContext.EditOperationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="8" Height="32" Width="32"/>
                                <Button Content="Eliminar" Command="{Binding DataContext.DeleteOperationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Padding="8" Height="32" Width="32" Foreground="#D32F2F"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="2" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     Value="0" IsIndeterminate="True" 
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" Height="50" Width="50"/>
    </Grid>
</UserControl>
