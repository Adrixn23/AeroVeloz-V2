<UserControl x:Class="AeroVeloz.Desktop.Views.SuperAdmin.AirportDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:AeroVeloz.Desktop.ViewModels.SuperAdmin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="14"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{DynamicResource MaterialDesignFont}"
             Width="600" Padding="24"
             MinHeight="400">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
            <TextBlock Text="Completa los detalles de la terminal." FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <Grid Grid.Row="1" Visibility="{Binding IsNotBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Name -->
            <TextBox Grid.ColumnSpan="3" Grid.Row="0" materialDesign:HintAssist.Hint="Nombre de Organización *" 
                     Text="{Binding NameOrganization, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <!-- ICAO / IATA -->
            <TextBox Grid.Column="0" Grid.Row="2" materialDesign:HintAssist.Hint="Código ICAO" 
                     Text="{Binding CodeAirportIcao, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                     
            <TextBox Grid.Column="2" Grid.Row="2" materialDesign:HintAssist.Hint="Código IATA *" 
                     Text="{Binding CodeAirportIata, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <!-- Country / City -->
            <TextBox Grid.Column="0" Grid.Row="4" materialDesign:HintAssist.Hint="País *" 
                     Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />
                     
            <TextBox Grid.Column="2" Grid.Row="4" materialDesign:HintAssist.Hint="Ciudad *" 
                     Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <!-- Email / TimeOffset -->
            <TextBox Grid.Column="0" Grid.Row="6" materialDesign:HintAssist.Hint="Correo Organizacional" 
                     Text="{Binding EmailOrganization, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" />

            <ComboBox Grid.Column="2" Grid.Row="6" 
                      ItemsSource="{Binding AvailableTimeZones}" 
                      SelectedItem="{Binding SelectedTimeZone, Mode=TwoWay}"
                      materialDesign:HintAssist.Hint="Zona Horaria *"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Active Toggle -->
            <CheckBox Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="8" Content="Activo" 
                      IsChecked="{Binding IsActived, UpdateSourceTrigger=PropertyChanged}"
                      Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Loading -->
        <ProgressBar Grid.Row="1" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     Value="0" IsIndeterminate="True" 
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" Height="40" Width="40"/>

        <!-- Actions -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,32,0,0">
            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Content="Cancelar" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" Margin="0,0,16,0" Padding="24,8" Height="Auto"/>
            <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="Guardar" Command="{Binding SaveCommand}" Padding="24,8" Height="Auto"/>
        </StackPanel>
    </Grid>
</UserControl>
