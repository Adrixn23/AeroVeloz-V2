<UserControl x:Class="AeroVeloz.Desktop.Views.SuperAdmin.AdminListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:AeroVeloz.Desktop.ViewModels.SuperAdmin"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="14"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="Transparent"
             FontFamily="{DynamicResource MaterialDesignFont}"
             Loaded="UserControl_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Administración de Usuarios" FontSize="26" FontWeight="SemiBold" Foreground="#333333"/>
            <TextBlock Text="Gestiona usuarios del sistema: crear, editar, desactivar y consultar historial de cambios." FontSize="14" Foreground="Gray"/>
        </StackPanel>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="1" Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     Value="0" IsIndeterminate="True" 
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" 
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,32,0,0" Height="50" Width="50"/>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Visibility="{Binding IsNotBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar Card with Actions -->
            <materialDesign:Card Grid.Row="0" Padding="24" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp2" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Column="0" 
                             materialDesign:HintAssist.Hint="Buscar usuario por nombre o email..." 
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,16,0"
                             Style="{StaticResource MaterialDesignFloatingHintTextBox}"/>

                    <!-- General Audit Button -->
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Command="{Binding LoadGlobalAuditCommand}"
                            Margin="0,0,8,0" Padding="16,8"
                            ToolTip="Ver auditoría de toda la organización">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Auditoría General" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Refresh Button -->
                    <Button Grid.Column="2" Style="{StaticResource MaterialDesignOutlinedButton}" 
                            Command="{Binding LoadDataCommand}"
                            Margin="0,0,8,0" Padding="16,8"
                            ToolTip="Refrescar y recargar la tabla">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Refrescar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Create Button -->
                    <Button Grid.Column="3" Style="{StaticResource MaterialDesignRaisedButton}" 
                            Command="{Binding CreateUserCommand}"
                            Margin="0,0,0,0" Padding="16,8"
                            ToolTip="Crear nuevo usuario">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="UserPlus" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="Nuevo Usuario" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </materialDesign:Card>

            <!-- Users List DataGrid -->
            <materialDesign:Card Grid.Row="1" Padding="24" UniformCornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Usuarios del Sistema" 
                               Margin="0,0,0,16" FontWeight="SemiBold" Foreground="#333333"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding SystemUsers}" 
                              AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" 
                              SelectionMode="Single" 
                              SelectedItem="{Binding SelectedUser}"
                              materialDesign:DataGridAssist.CornerRadius="0,0,8,8" 
                              IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nombre de Usuario" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Rol" Binding="{Binding Role}" Width="150"/>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding IsActive, Mode=OneWay}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Bloqueado" Binding="{Binding IsBlocked, Mode=OneWay}" Width="100"/>

                            <DataGridTemplateColumn Header="Acciones" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                    ToolTip="Editar" 
                                                    Command="{Binding DataContext.EditUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" 
                                                    Foreground="{DynamicResource PrimaryHueMidBrush}">
                                                <materialDesign:PackIcon Kind="Pencil" />
                                            </Button>
                                            <Button Style="{StaticResource MaterialDesignIconButton}" 
                                                    ToolTip="Desactivar" 
                                                    Command="{Binding DataContext.DeactivateUserCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                    CommandParameter="{Binding}" 
                                                    Foreground="#D32F2F" 
                                                    Margin="8,0,0,0">
                                                <materialDesign:PackIcon Kind="UserRemove" />
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </materialDesign:Card>

            <!-- Audit Section (Expandible) -->
            <Expander Grid.Row="2" Margin="0,24,0,0" Padding="0" 
                      IsExpanded="{Binding IsAuditVisible, Mode=TwoWay}"
                      Visibility="{Binding IsAuditVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal" Margin="16,12">
                        <materialDesign:PackIcon Kind="History" Width="24" Height="24" Margin="0,0,12,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        <TextBlock Text="Historial de Cambios" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedUserAudit.Count, StringFormat='({0})'}" Margin="8,0,0,0" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>
                </Expander.Header>

                <Border Background="White" CornerRadius="0,0,8,8" materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding AuditTitle}" 
                                   Margin="24,16" FontSize="13" Foreground="Gray" FontWeight="Medium"/>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedUserAudit}" 
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  materialDesign:DataGridAssist.CornerRadius="0,0,8,8"
                                  IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Tipo de Acción" Binding="{Binding AuditTypeName}" Width="140"/>
                                <DataGridTextColumn Header="Realizado por" Binding="{Binding NameUser}" Width="180"/>
                                <DataGridTextColumn Header="Entidad" Binding="{Binding NameEntity}" Width="100"/>
                                <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding OccurredAt, StringFormat='dd/MM/yyyy HH:mm:ss'}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</UserControl>

